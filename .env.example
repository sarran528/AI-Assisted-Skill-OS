# Backend
APP_ENV=local

# Database
DATABASE_URL=postgres+asyncpg://<db_user>:<db_password>@<db_host>:5432/<db_name>

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=postgres+asyncpg://<db_user>:<db_password>@<db_host>:5432/<db_name>

# JWT
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=local-1
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000
JWT_ISSUER=https://skillos.app
JWT_AUDIENCE=skillos-api

# LLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SERPER_API_KEY=your_serper_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here
SEARCH_PROVIDER=serper
GROQ_API_KEY=your_groq_api_key_here
TOGETHER_API_KEY=your_together_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
LLM_PROVIDER=openai
LLM_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.0
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=100
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_PATH=backend/data/faiss/skill_templates.index
FAISS_METADATA_PATH=backend/data/faiss/skill_templates.meta.json

# Object storage (Nhost)
NHOST_STORAGE_ENDPOINT=https://<subdomain>.storage.<region>.nhost.run/v1
NHOST_STORAGE_BUCKET=
NHOST_STORAGE_ACCESS_KEY=
NHOST_STORAGE_SECRET_KEY=

# S3 / R2 object storage
S3_BUCKET_NAME=skillos-dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=<s3_access_key_id>
S3_SECRET_ACCESS_KEY=<s3_secret_access_key>
S3_ENDPOINT_URL=http://localhost:9000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
